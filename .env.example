# SkillForge environment configuration
# Copy this file to .env and replace values for your deployment.

APP_NAME=SkillForge
ENVIRONMENT=production
DEBUG=false

# Core app security
SECRET_KEY=replace-with-a-strong-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ALGORITHM=HS256

# Use a managed PostgreSQL URL and keep credentials in your deployment secret store.
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/skillforge

# MongoDB configuration
MONGO_URL=mongodb+srv://USER:PASSWORD@MONGO_HOST/skillforge
MONGO_DATABASE=skillforge

# AI configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# CORS / frontend access
ALLOWED_ORIGINS=https://your-frontend-domain.com
